<?xml version="1.0" encoding="utf-8"?>
<!-- SC2 Partout — APK (passe 7a ; lanceur passe 10b). L'icône ouvre le lanceur Java (fr.sc2partout.LanceurActivity,
     android/src/) : cartes de la campagne, sc2.env, puis le jeu. La bibliothèque lib/arm64-v8a/libSC2Partout.so porte
     le runtime recomp-sc2 et android_main (android.app.NativeActivity). Aucune permission réseau : 100 % hors ligne. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="fr.sc2partout"
    android:versionCode="8"
    android:versionName="0.10b">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />

    <!-- Données du jeu dans /sdcard/SC2Partout/install : accès « tous les fichiers » (Android 11+,
         accordé par adb : appops MANAGE_EXTERNAL_STORAGE allow) ; lecture classique jusqu'à Android 12. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!-- Backend 5c : Vulkan 1.3 (rendu dynamique) ; non bloquant à l'installation, vérifié au lancement. -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x403000" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="@string/app_name"
        android:hasCode="true"
        android:debuggable="true"
        android:extractNativeLibs="true"
        android:resizeableActivity="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/Plein">

        <!-- Passe 10b : lanceur, point d'entrée de l'icône. -->
        <activity
            android:name="fr.sc2partout.LanceurActivity"
            android:exported="true"
            android:theme="@style/Lanceur">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Le jeu : lancé par le lanceur (intention explicite). exported="true" garde les recettes adb
             (am start -n fr.sc2partout/android.app.NativeActivity). Processus « :jeu » : le runtime finit par exit(0),
             le lanceur survit et réapparaît ; chaque partie repart d'un processus neuf (état statique de la .so). -->
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:process=":jeu"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:resizeableActivity="true">
            <meta-data android:name="android.app.lib_name" android:value="SC2Partout" />
        </activity>
    </application>
</manifest>
